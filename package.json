{
  "name": "@local/dsh-wrongbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wrong-question notebook for science subjects: Markdown/LaTeX notes, review tracking, a subject/tag directory, and one-shot AI-generated similar problems.",
  "license": "MIT",
  "author": "Goman",
  "homepage": "https://github.com/Mason233Hello/dsh-wrongbook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mason233Hello/dsh-wrongbook.git"
  },
  "bugs": {
    "url": "https://github.com/Mason233Hello/dsh-wrongbook/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "wrong-answers",
    "mistake-notebook",
    "education",
    "latex",
    "katex"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
